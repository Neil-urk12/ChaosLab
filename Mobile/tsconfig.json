{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@web/*": ["../Frontend/src/lib/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // The client test runs under `node --test` and imports with a .ts extension, which the app build does not allow.
  "exclude": ["node_modules", "**/*.test.ts"]
}

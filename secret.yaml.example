apiVersion: v1
kind: Secret
metadata:
  name: chaoslab-secret
type: Opaque
stringData:
  postgres-password: change_me_postgres_password
  connection-string: "Host=localhost;Port=5432;Database=chaos_db;Username=postgres;Password=change_me_postgres_password"
  # Encrypts target API credentials. Generate with: openssl rand -base64 32
  credentials-key: "change_me_base64_32_byte_key"

# Copy to Backend/.env.local (gitignored). The backend loads it at startup and `make migrate` uses it;
# exported variables and the pod secret take precedence over it.

# Optional: `dotnet run` uses the Development launch profile. For another environment, set this and run
# `dotnet run --no-launch-profile`.
# ASPNETCORE_ENVIRONMENT=Development

# The pod's database (`make up`) listens on localhost:5432; use postgres-password from secret.yaml.
ConnectionStrings__DefaultConnection='Host=localhost;Port=5432;Database=chaos_db;Username=postgres;Password=<DB_PASSWORD>'

# Encrypts target API credentials (base64, 32 bytes): openssl rand -base64 32
# Use the same value as credentials-key in secret.yaml so both backends can read the stored secrets.
Credentials__Key=<BASE64_32_BYTE_KEY>

ASPNETCORE_ENVIRONMENT=Testing # Development / Production / Staging
ConnectionStrings__DefaultConnection='Host=<DB_HOST>;Port=5432;Database=chaoslab_testing;Username=<DB_USER>;Password=<DB_PASSWORD>'

# Encrypts target API credentials (base64, 32 bytes): openssl rand -base64 32
Credentials__Key=<BASE64_32_BYTE_KEY>
